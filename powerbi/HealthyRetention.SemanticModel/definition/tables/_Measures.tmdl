table _Measures
	lineageTag: 1ea1b29e-6212-444a-b8cd-d2b746c5c720

	measure 'Approved Deposits' =
			
			CALCULATE (
			    COUNTROWS ( fct_transactions ),
			    fct_transactions[transaction_category] = "deposit_to_gambling",
			    fct_transactions[is_approved] = TRUE ()
			)
		formatString: 0
		lineageTag: 3a2f18b2-82c8-455a-84de-f1e0c03ed84f

	measure 'Deposit Amount' =
			
			CALCULATE (
			    SUM ( fct_transactions[approved_amount_usd] ),
			    fct_transactions[transaction_category] = "deposit_to_gambling"
			)
		lineageTag: 4b6bc059-4504-407a-aacf-071e2ebdd384

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Depositing Players' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fct_transactions[player_id] ),
			    fct_transactions[transaction_category] = "deposit_to_gambling",
			    fct_transactions[is_approved] = TRUE ()
			)
		formatString: 0
		lineageTag: b65bf8e2-8d58-4e33-9aca-8c935d7a1b21

	measure 'Funding Attempts' =
			
			CALCULATE (
			    COUNTROWS ( fct_transactions ),
			    fct_transactions[transaction_category] IN { "wallet_funding_card", "wallet_funding_ach" }
			)
		formatString: 0
		lineageTag: 763d1a96-8d0c-4a52-9470-aa2e9b4e4581

	measure 'Funding Declines' =
			
			CALCULATE (
			    [Funding Attempts],
			    fct_transactions[is_approved] = FALSE ()
			)
		formatString: 0
		lineageTag: c6417714-38eb-4d88-af6a-711a6029ae25

	measure 'Funding Decline Rate' =
			
			DIVIDE ( [Funding Declines], [Funding Attempts] )
		lineageTag: 8391fe11-94bb-4767-bff2-f67678102e29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Players =
			
			COUNTROWS ( dim_player )
		formatString: 0
		lineageTag: 8c831ed3-7897-49a3-b14f-791aac8abcd2

	measure '% of Players' =
			
			DIVIDE (
			    [Players],
			    CALCULATE ( [Players], ALLSELECTED ( dim_player ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 838639dd-52ed-473b-93e2-d19259d4e7d1

	measure 'Active M1 Players' =
			
			CALCULATE ( [Players], dim_player[active_m1] = TRUE () )
		formatString: 0
		lineageTag: c2d79988-3c1b-4521-9f9f-e129ec229a45

	measure 'Active M2 Players' =
			
			CALCULATE ( [Players], dim_player[active_m2] = TRUE () )
		formatString: 0
		lineageTag: 624855c8-fbca-462e-b6d6-f2f02036c923

	measure 'Active M3 Players' =
			
			CALCULATE ( [Players], dim_player[active_m3] = TRUE () )
		formatString: 0
		lineageTag: 41c26d6c-5fbe-41ab-b981-91d4c41e30b8

	measure 'Retention M1' =
			
			DIVIDE ( [Active M1 Players], [Players] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7c074656-ad5d-498f-ab93-4a104c0e3506

	measure 'Retention M2' =
			
			DIVIDE ( [Active M2 Players], [Players] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: be704071-f34d-4431-a7bb-adddc4537f48

	measure 'Retention M3' =
			
			DIVIDE ( [Active M3 Players], [Players] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cfcebd10-4b7e-41c3-aa71-8557d73113da

	measure 'Retention %' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fct_player_month ), fct_player_month[is_active] = TRUE () ),
			    COUNTROWS ( fct_player_month )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0cc579c4-83da-4dc4-a861-fd7314009d68

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

