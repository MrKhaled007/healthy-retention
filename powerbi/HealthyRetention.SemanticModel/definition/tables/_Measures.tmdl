table _Measures
	lineageTag: 1ea1b29e-6212-444a-b8cd-d2b746c5c720

	measure 'Approved Deposits' =
			
			CALCULATE (
			    COUNTROWS ( fct_transactions ),
			    fct_transactions[transaction_category] = "deposit_to_gambling",
			    fct_transactions[is_approved] = TRUE ()
			)
		formatString: 0
		lineageTag: 3a2f18b2-82c8-455a-84de-f1e0c03ed84f

	measure 'Deposit Amount' =
			
			CALCULATE (
			    SUM ( fct_transactions[approved_amount_usd] ),
			    fct_transactions[transaction_category] = "deposit_to_gambling"
			)
		lineageTag: 4b6bc059-4504-407a-aacf-071e2ebdd384

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Depositing Players' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fct_transactions[player_id] ),
			    fct_transactions[transaction_category] = "deposit_to_gambling",
			    fct_transactions[is_approved] = TRUE ()
			)
		formatString: 0
		lineageTag: b65bf8e2-8d58-4e33-9aca-8c935d7a1b21

	measure 'Funding Attempts' =
			
			CALCULATE (
			    COUNTROWS ( fct_transactions ),
			    fct_transactions[transaction_category] IN { "wallet_funding_card", "wallet_funding_ach" }
			)
		formatString: 0
		lineageTag: 763d1a96-8d0c-4a52-9470-aa2e9b4e4581

	measure 'Funding Declines' =
			
			CALCULATE (
			    [Funding Attempts],
			    fct_transactions[is_approved] = FALSE ()
			)
		formatString: 0
		lineageTag: c6417714-38eb-4d88-af6a-711a6029ae25

	measure 'Funding Decline Rate' =
			
			DIVIDE ( [Funding Declines], [Funding Attempts] )
		lineageTag: 8391fe11-94bb-4767-bff2-f67678102e29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Players =
			
			COUNTROWS ( dim_player )
		formatString: 0
		lineageTag: 8c831ed3-7897-49a3-b14f-791aac8abcd2

	measure '% of Players' =
			
			DIVIDE (
			    [Players],
			    CALCULATE ( [Players], ALLSELECTED ( dim_player ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 838639dd-52ed-473b-93e2-d19259d4e7d1

	measure 'Active M1 Players' =
			
			CALCULATE ( [Players], dim_player[active_m1] = TRUE () )
		formatString: 0
		lineageTag: c2d79988-3c1b-4521-9f9f-e129ec229a45

	measure 'Active M2 Players' =
			
			CALCULATE ( [Players], dim_player[active_m2] = TRUE () )
		formatString: 0
		lineageTag: 624855c8-fbca-462e-b6d6-f2f02036c923

	measure 'Active M3 Players' =
			
			CALCULATE ( [Players], dim_player[active_m3] = TRUE () )
		formatString: 0
		lineageTag: 41c26d6c-5fbe-41ab-b981-91d4c41e30b8

	measure 'Retention M1' =
			
			DIVIDE ( [Active M1 Players], [Players] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7c074656-ad5d-498f-ab93-4a104c0e3506

	measure 'Retention M2' =
			
			DIVIDE ( [Active M2 Players], [Players] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: be704071-f34d-4431-a7bb-adddc4537f48

	measure 'Retention M3' =
			
			DIVIDE ( [Active M3 Players], [Players] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cfcebd10-4b7e-41c3-aa71-8557d73113da

	measure 'Retention %' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fct_player_month ), fct_player_month[is_active] = TRUE () ),
			    COUNTROWS ( fct_player_month )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0cc579c4-83da-4dc4-a861-fd7314009d68

	measure 'Journey Players' =
			
			VAR CurrentStep = SELECTEDVALUE ( 'Journey Steps'[Step] )
			RETURN
			    CALCULATE ( [Players], dim_player[journey_stage] >= CurrentStep )
		formatString: 0
		lineageTag: 82864221-de0f-40f0-9e39-2b3241485685

	measure 'Journey % of New Players' =
			
			DIVIDE (
			    [Journey Players],
			    CALCULATE (
			        [Journey Players],
			        REMOVEFILTERS ( 'Journey Steps' ),
			        'Journey Steps'[Step] = 1
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 235980ad-6383-418a-a91b-673a4b82dda5

	measure 'Journey % of Previous Step' =
			
			VAR CurrentStep = SELECTEDVALUE ( 'Journey Steps'[Step] )
			RETURN
			    IF (
			        CurrentStep > 1,
			        DIVIDE (
			            [Journey Players],
			            CALCULATE (
			                [Journey Players],
			                REMOVEFILTERS ( 'Journey Steps' ),
			                'Journey Steps'[Step] = CurrentStep - 1
			            )
			        )
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 46155714-b950-4895-9fe0-7cf0040d4adf

	measure '% of Deposit Money' =
			
			DIVIDE (
			    [Deposit Amount],
			    CALCULATE ( [Deposit Amount], ALLSELECTED ( dim_player ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 89525e71-ae0b-4e11-b630-6aec20856518

	measure 'Median Monthly Deposit' =
			
			MEDIAN ( dim_player[monthly_deposit_usd] )
		lineageTag: 2726de92-a2cc-4f41-8c93-d6113029f251

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'M3 Deposit Amount' =
			
			CALCULATE (
			    SUM ( fct_player_month[deposits_amount_usd] ),
			    fct_player_month[months_since_first_seen] = 3
			)
		lineageTag: a0761c10-838e-4767-b54a-f70d215a9494

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of M3 Deposit Money' =
			
			DIVIDE (
			    [M3 Deposit Amount],
			    CALCULATE ( [M3 Deposit Amount], ALLSELECTED ( dim_player ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7168d973-cec3-4bde-a52c-51727d11cb8e

	measure '% of M3 Active Players' =
			
			DIVIDE (
			    [Active M3 Players],
			    CALCULATE ( [Active M3 Players], ALLSELECTED ( dim_player ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dd4b0b89-d441-4186-975d-b2b50dd21fdd

	measure 'Group Players' =
			
			VAR Threshold = [HI Threshold Value]
			VAR CurrentGroup = SELECTEDVALUE ( 'Spend Group'[Group] )
			VAR GroupPlayers =
			    FILTER (
			        dim_player,
			        NOT ISBLANK ( dim_player[first_deposit_date] )
			            && SWITCH (
			                CurrentGroup,
			                "Early high-intensity", dim_player[first_30d_deposit_usd] > Threshold,
			                "Other depositors", dim_player[first_30d_deposit_usd] <= Threshold,
			                TRUE ()
			            )
			    )
			RETURN
			    CALCULATE ( [Players], KEEPFILTERS ( GroupPlayers ) )
		formatString: 0
		lineageTag: 546238b0-5263-4ca6-aa87-4c81a33829d1

	measure 'Group Active M1' =
			
			CALCULATE ( [Group Players], dim_player[active_m1] = TRUE () )
		formatString: 0
		lineageTag: 3919e65d-9989-4b71-88e5-d8fad3d8b4e1

	measure 'Group Active M2' =
			
			CALCULATE ( [Group Players], dim_player[active_m2] = TRUE () )
		formatString: 0
		lineageTag: da5b1b87-f753-47df-8ca9-4726205775b4

	measure 'Group Active M3' =
			
			CALCULATE ( [Group Players], dim_player[active_m3] = TRUE () )
		formatString: 0
		lineageTag: 3db530a6-6a8e-4aff-9301-6d0fca9d5aea

	measure 'Group Retention M1' =
			
			DIVIDE ( [Group Active M1], [Group Players] )
		lineageTag: a079d450-7d05-4dd0-ba86-24d52a04bedf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Group Retention M2' =
			
			DIVIDE ( [Group Active M2], [Group Players] )
		lineageTag: 15f23d36-78e7-4600-a9e4-ee8957b23794

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Group Retention M3' =
			
			DIVIDE ( [Group Active M3], [Group Players] )
		lineageTag: a2eba0fd-65aa-4a99-92e3-7e833108e394

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Group % of M3 Active' =
			
			DIVIDE (
			    [Group Active M3],
			    CALCULATE ( [Group Active M3], REMOVEFILTERS ( 'Spend Group' ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f642f3f9-ec97-4675-b4d8-0f4799f41528

	measure 'Group M3 Deposit Amount' =
			
			VAR Threshold = [HI Threshold Value]
			VAR CurrentGroup = SELECTEDVALUE ( 'Spend Group'[Group] )
			VAR GroupPlayers =
			    FILTER (
			        dim_player,
			        NOT ISBLANK ( dim_player[first_deposit_date] )
			            && SWITCH (
			                CurrentGroup,
			                "Early high-intensity", dim_player[first_30d_deposit_usd] > Threshold,
			                "Other depositors", dim_player[first_30d_deposit_usd] <= Threshold,
			                TRUE ()
			            )
			    )
			RETURN
			    CALCULATE ( [M3 Deposit Amount], KEEPFILTERS ( GroupPlayers ) )
		lineageTag: be9ef110-a088-46d3-b01c-dd45851f2455

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Group % of M3 Money' =
			
			DIVIDE (
			    [Group M3 Deposit Amount],
			    CALCULATE ( [Group M3 Deposit Amount], REMOVEFILTERS ( 'Spend Group' ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6ffc57e7-e8b5-4a88-86a2-1ebc3e83b5b6

	measure 'Cohort Range Label' =
			
			VAR FirstCohort = MIN ( dim_player[cohort_month] )
			VAR LastCohort = MAX ( dim_player[cohort_month] )
			RETURN
			    IF (
			        FirstCohort = LastCohort,
			        FORMAT ( FirstCohort, "mmm yyyy" ),
			        FORMAT ( FirstCohort, "mmm yyyy" ) & " – " & FORMAT ( LastCohort, "mmm yyyy" )
			    )
		lineageTag: 9aebfe59-4a01-4ad0-8493-7771d70b0853

	measure 'Brand Label' =
			
			SELECTEDVALUE ( dim_player[brand], "all brands" )
		lineageTag: 817f8fec-34b7-4c0c-9f17-adb04d9bb00c

	measure 'Title Journey' =
			
			"Deposit journey · new " & [Brand Label] & " players · cohorts "
			    & [Cohort Range Label] & " · " & FORMAT ( [Players], "#,0" ) & " players"
		lineageTag: e7c5734f-9629-476a-be6f-344c14702f5d

	measure 'Title Retention' =
			
			"Monthly retention · new " & [Brand Label] & " players · cohorts "
			    & [Cohort Range Label] & " · " & FORMAT ( [Players], "#,0" ) & " players"
		lineageTag: d679604a-9ca8-4e65-8061-58b2bfe01c4c

	measure 'Title Segments' =
			
			"Depositor segments · " & [Brand Label] & " depositors · "
			    & FORMAT ( [Players], "#,0" ) & " players"
		lineageTag: a8b2d55b-a972-44da-98fb-61f1151a7d6f

	measure 'Title Healthy Retention' =
			
			"New " & [Brand Label] & " depositors · cohorts " & [Cohort Range Label]
			    & " · " & FORMAT ( [Group Players], "#,0" ) & " players · threshold "
			    & FORMAT ( [HI Threshold Value], "$#,0" ) & " in first 30 days"
		lineageTag: 40dfa039-da3e-4c83-8408-6bfe7adea1e1

	measure 'Title Friction' =
			
			"New " & [Brand Label] & " players who tried to fund · cohorts "
			    & [Cohort Range Label] & " · " & FORMAT ( [Players], "#,0" ) & " players"
		lineageTag: f0fcbd19-a90c-49bb-98a6-f38646585f77

	measure 'Segment Chart Title' =
			
			SWITCH (
			    SELECTEDVALUE ( 'Segment Measure'[Segment Measure] ),
			    "Share of players", "Share of depositors by segment",
			    "Share of money", "Share of deposit money by segment",
			    "Median $/month", "Typical monthly deposit by segment",
			    "Share of deposit money by segment"
			)
		lineageTag: 3c4d5dec-2336-4081-bcfe-68fd4fef682d

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

